# Claude API Key (from https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# --- Gmail (recommended) ---
# Create at https://console.cloud.google.com > APIs & Services > Credentials
# Enable the Gmail API, then create an OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Outlook (optional, if you want Outlook instead) ---
# Create at https://portal.azure.com > App registrations
# Required API permissions: Mail.ReadWrite, Mail.Send (delegated)
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_TENANT_ID=your-tenant-id

# --- Cloud deployment (Railway, Render, etc.) ---
# Set APP_URL to your deployed URL so Gmail OAuth redirect works
# APP_URL=https://your-app-name.up.railway.app

# Optional: defaults shown
# CLAUDE_MODEL=claude-sonnet-4-20250514
